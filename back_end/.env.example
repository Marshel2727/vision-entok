APP_NAME="Deteksi Entok Backend"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
API_PREFIX="/api"
FRONTEND_URL="http://localhost:3000"

DATABASE_URL="mysql+pymysql://root@127.0.0.1:3306/cv_entok_db?charset=utf8mb4"

UPLOAD_DIR="app/static/uploads"
ANNOTATED_DIR="app/static/annotated"
CAMERA_MEDIA_DIR="app/static/camera"
TEMP_DIR="app/static/temp"
MAX_UPLOAD_MB=10

AI_MODEL_PATH="ai/models/best.pt"
AI_CONFIDENCE_THRESHOLD=0.50
ABNORMAL_LABEL="abnormal"
SAVE_ABNORMAL_ONLY=true

# Simpan credential CCTV hanya di back_end/.env (file ini adalah contoh).
CCTV_RTSP_URL="rtsp://username:password@192.168.1.10:554/stream1"

JWT_SECRET_KEY="replace-with-a-long-random-value"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
AUTH_COOKIE_SECURE=false
APP_ENCRYPTION_KEY=""

LOG_LEVEL="INFO"
LOG_DIR="logs"
IMAGE_RETENTION_DAYS=30
CAMERA_METADATA_RETENTION_DAYS=90
